# URL baza danych PostgreSQL
DATABASE_URL=postgresql://forecast_user:forecast_pass@db:5432/forecast_db

# Secret key do tokenów JWT — zmień na losowy string w produkcji
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Algorytm JWT
ALGORITHM=HS256

# Czas ważności tokenu w minutach (8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Dane bazy danych (używane przez kontener Docker)
POSTGRES_USER=forecast_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=forecast_db

# IP serwera produkcyjnego (dodawane do dozwolonych originów CORS)
SERVER_IP=